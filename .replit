modules = ["nodejs-24"]
[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Worker"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BETTER_AUTH_SECRET=$SESSION_SECRET BETTER_AUTH_URL=https://$REPLIT_DEV_DOMAIN pnpm dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Worker"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node --import tsx/esm worker/index.ts"

[[ports]]
localPort = 5000
externalPort = 80
