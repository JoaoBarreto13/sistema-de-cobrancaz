# Copie este arquivo para .env e preencha os valores

# PostgreSQL — use o Supabase connection pooler (porta 6543) ou qualquer Postgres acessível
DATABASE_URL=postgresql://postgres:SENHA@aws-0-region.pooler.supabase.com:6543/postgres

# Segredo para assinar sessões e tokens Better Auth (qualquer string longa e aleatória)
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# URL pública onde o app estará rodando (usado pelo Better Auth para CSRF e OAuth)
# Localmente: http://localhost:5000
BETTER_AUTH_URL=http://localhost:5000

# Pasta onde o Baileys salva os arquivos de sessão do WhatsApp
BAILEYS_AUTH_DIR=.baileys-auth
