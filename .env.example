# Copie este arquivo para .env e preencha os valores

# PostgreSQL — use o Supabase connection pooler (porta 6543) ou qualquer Postgres acessível
DATABASE_URL=postgresql://postgres:SENHA@aws-0-region.pooler.supabase.com:6543/postgres

# Segredo para assinar sessões e tokens Better Auth (qualquer string longa e aleatória)
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Segredo explícito do Better Auth. Pode reutilizar o mesmo valor de SESSION_SECRET.
BETTER_AUTH_SECRET=troque-por-uma-string-longa-e-aleatoria

# URL pública onde o app estará rodando (usado pelo Better Auth para CSRF e OAuth)
# Localmente: http://localhost:5000
BETTER_AUTH_URL=http://localhost:5000

# Pasta onde o Baileys salva os arquivos de sessão do WhatsApp
BAILEYS_AUTH_DIR=.baileys-auth

# Certificado raiz do banco (use UM dos dois; obrigatório para Supabase remoto)
# Baixe em: Painel Supabase → Project Settings → Database → SSL → Download certificate
# DATABASE_SSL_CA_PATH=./certs/supabase-ca.crt
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Criação do primeiro admin (somente para pnpm user:admin)
# ADMIN_USERNAME=meu_usuario
# ADMIN_PASSWORD=minhasenha

# Tamanho máximo de anexos de comprovante em MB (padrão: 15)
# ATTACHMENT_MAX_MB=15

# Retenção de anexos em dias (opcional; sem definição = nunca apaga)
# ATTACHMENT_RETENTION_DAYS=90
